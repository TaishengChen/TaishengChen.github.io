# ===================================================================
# General Front-End Dependencies & Build Artifacts
# ===================================================================

# Dependency directories
# These are generated by running 'npm install' or 'yarn'
node_modules/

# Build output directories for various frameworks (Next.js, React, etc.)
.next/
out/
build/
dist/
.output/
.vercel/

# Log files generated by package managers
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Lockfiles from different package managers (optional, but good practice
# if your team might use different tools, though it's best to standardize)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml


# ===================================================================
# Sensitive Environment Variables
# ===================================================================

# Never commit environment variables.
# Create a .env.example file to show what variables are needed.
.env
.env.local
.env.development.local
.env.test.local
.env.production.local


# ===================================================================
# IDE-Specific Files (JetBrains WebStorm)
# ===================================================================

# Covers all JetBrains IDEs (WebStorm, IntelliJ, etc.)
# User-specific settings, configurations, and caches
.idea/

# Deprecated folder for older versions
# .idea_modules/


# ===================================================================
# Operating System Specific Files (Windows & macOS)
# ===================================================================

# Windows thumbnail cache and folder settings
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS folder settings file (good practice to include for cross-platform teams)
.DS_Store


# ===================================================================
# Other Common Files to Ignore
# ===================================================================

# Test reports and coverage
coverage/
.nyc_output/

# Editor directories and files
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

